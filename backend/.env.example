NODE_ENV=development
PORT=5000

FRONTEND_URL=http://localhost:3000

# Express runtime identity. After 0005_security_hardening is applied and
# maison_app LOGIN is enabled, this must be the maison_app role — never postgres.
# Direct (persistent backend, IPv6 or IPv4 add-on):
#   postgresql://maison_app:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Shared pooler session mode (IPv4). Username is maison_app.PROJECT_REF, not maison_app:
#   postgresql://maison_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Shared pooler transaction mode. Same username form; port 6543:
#   postgresql://maison_app.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Dedicated pooler (Pro+). Username is the role only, like direct:
#   postgresql://maison_app:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres
# Copy host/port from the Supabase Connect dialog. Do not invent the pooler host.
DATABASE_URL=postgresql://maison_app:PASSWORD@HOST:5432/postgres

# Privileged migration administrator for drizzle-kit generate/migrate/studio only.
# Use a direct connection. Express does not read this variable.
# Direct postgres example (username is postgres, not postgres.PROJECT_REF):
#   postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/postgres

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Inventory reservation TTL used at checkout. Default 900 seconds (15 minutes).
RESERVATION_TTL_SECONDS=900

# Set to 1 when Express is behind a reverse proxy (required for accurate rate limiting).
TRUST_PROXY=0

# Payments, shipping, and real email delivery are deferred. Leave these empty.
# Never put live keys in frontend code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
