# Origin only. The client appends /api/v1 — do not include it here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Server-side only (Next.js generate/publish routes and `npm run ar:publish`).
# Never prefix with NEXT_PUBLIC_. Never put this value in browser code.
# SUPABASE_SERVICE_ROLE_KEY=
# AR_ASSETS_BUCKET=ar-assets
# AR_ASSETS_STAGING_BUCKET=ar-assets-staging
